{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "scribe",
  "version": "0.1.0",
  "identifier": "com.runling.scribe",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "scribe",
        "width": 1024,
        "height": 720,
        "decorations": false, 
        "transparent": true
      }
    ],
    "security": {
      "csp": null,
      "dangerousDisableAssetCspModification": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/scribe48.ico",
      "icons/scribe256.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "wix": {
        "fragmentPaths": [],
        "componentGroupRefs": []
      }
    }
  }
}
